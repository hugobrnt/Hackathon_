# Copy this file to backend/.env and fill in the values you need.
# All variables are optional: without them, the backend runs in demo mode
# (POST /demo/load, keyword classification, template texts). Never commit backend/.env.

# --- Zernio (real social accounts: import, webhooks, DMs, boost) ---
ZERNIO_API_KEY=
# Optional: Zernio profile used for the OAuth connection. Default: your first profile.
ZERNIO_PROFILE_ID=
# Any long random string; used to verify the signature of the Zernio webhooks.
# Example: openssl rand -hex 32
ZERNIO_WEBHOOK_SECRET=

# --- Cloudflare Workers AI (LLM classification, DMs, insights, agent) ---
# Without them, the backend uses keyword rules and template texts.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: route the LLM calls through an AI Gateway.
CLOUDFLARE_AI_GATEWAY_ID=

# --- URLs ---
# Public URL of this API (OAuth callback). Use a tunnel URL for real accounts,
# for example: cloudflared tunnel --url http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000
# Public URL of the short tracked links in the DMs. Default: PUBLIC_BASE_URL.
TRACKING_BASE_URL=
# Origin of the frontend (CORS and OAuth redirect).
FRONTEND_URL=http://localhost:5173

# --- Storage ---
# Default: SQLite file backend/data.db (created at startup).
# DATABASE_URL=sqlite:////absolute/path/to/data.db

# --- Guardrails (defaults shown) ---
# AUTO_DM_MAX_AGE_DAYS=7
# ADS_MAX_TOTAL_BUDGET=50
# AGENT_MAX_REPLIES=3
# Answer the prospects who write a DM first (purchase, question, objection).
# AGENT_REPLY_INBOUND_DMS=true
